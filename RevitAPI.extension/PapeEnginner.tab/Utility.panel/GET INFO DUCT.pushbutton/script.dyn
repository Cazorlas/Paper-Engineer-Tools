    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "import os\r\nimport sys\r\nimport clr\r\nimport System\r\nimport math\r\nfrom System.Collections.Generic import *\r\n\r\nclr.AddReference(\"ProtoGeometry\")\r\nfrom Autodesk.DesignScript.Geometry import *\r\n\r\nclr.AddReference('RevitAPI')\r\nimport Autodesk\r\nfrom Autodesk.Revit.DB import *\r\n\r\nclr.AddReference('RevitAPIUI')\r\nfrom Autodesk.Revit.UI import *\r\nfrom Autodesk.Revit.UI.Selection import *\r\n\r\nclr.AddReference(\"RevitNodes\")\r\nimport Revit\r\n\r\nclr.ImportExtensions(Revit.Elements)\r\nclr.ImportExtensions(Revit.GeometryConversion)\r\n\r\nclr.AddReference(\"RevitServices\")\r\nimport RevitServices\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\nview = doc.ActiveView\r\nuidoc = DocumentManager.Instance.CurrentUIApplication.ActiveUIDocument\r\nuiapp = DocumentManager.Instance.CurrentUIApplication\r\napp = uiapp.Application\r\n\r\n\"\"\"-------------Preparing input from dynamo to revit----------------\"\"\"\r\nINPUT = IN[0]\r\n\r\n\"\"\"--------------------------Functions--------------------------\"\"\"\r\ndef ShowTaskDialog(title, mainInstruction, icon, mainContent,verificationText, footerText, footerUrl):\r\n    # Tạo TaskDialog\r\n    dialog = TaskDialog(title)\r\n    dialog.TitleAutoPrefix = False\r\n    dialog.MainInstruction = mainInstruction\r\n    if icon:\r\n        dialog.MainIcon = icon\r\n    dialog.MainContent = mainContent\r\n    dialog.CommonButtons = TaskDialogCommonButtons.Ok\r\n\r\n    # Thêm checkbox vào TaskDialog\r\n    dialog.VerificationText = verificationText\r\n    \r\n    # Định dạng FooterText với thẻ <a> và gán vào FooterText\r\n    dialog.FooterText = '<a href=\"{0}\">{1}</a>'.format(footerUrl, footerText)\r\n\r\n    # Hiển thị TaskDialog và nhận kết quả\r\n    dialog.Show()\r\n    \r\n    # Kiểm tra trạng thái của checkbox\r\n    return dialog.WasVerificationChecked()\r\n\r\n\"\"\"--------------------------Main Code--------------------------\"\"\"\r\nif INPUT:\r\n\tresult = ShowTaskDialog(\r\n\t                title=\"PKD\",\r\n\t                mainInstruction=\"Select Mode\",\r\n\t                icon=None,\r\n\t                mainContent=\"Choose In View will excecute all VAV,CAV elements in View\\n\\nChoose Picking will excecute Picking Objects\",\r\n\t                verificationText = \"IN VIEW / PICKING OBJECTS\",\r\n\t                footerText=\"Get help\",\r\n\t                footerUrl=\"https://www.youtube.com/@paper.engineer\"\r\n\t            )\r\n\r\n# Assign output to Dynamo\r\nOUT = result\r\n",
      "Engine": "IronPython2",
      "EngineName": "IronPython2",
      "VariableInputPorts": true,
      "Id": "17af8a07ca2547c4804f77c1dbc3c07b",
      "Inputs": [
        {
          "Id": "20eca044d06d448fb2d0b3746158d9c6",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "ad0ded53d1854c259a23ae2a4c0c76ea",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "import clr\r\nclr.AddReference('System.Windows.Forms')\r\nfrom System.Windows.Forms import FolderBrowserDialog, DialogResult\r\n\r\nimport os\r\nimport sys\r\n\r\nimport System\r\nimport math\r\nfrom System.Collections.Generic import *\r\n\r\nclr.AddReference(\"ProtoGeometry\")\r\nfrom Autodesk.DesignScript.Geometry import *\r\n\r\nclr.AddReference('RevitAPI')\r\nimport Autodesk\r\nfrom Autodesk.Revit.DB import *\r\n\r\nclr.AddReference('RevitAPIUI')\r\nfrom Autodesk.Revit.UI import *\r\nfrom Autodesk.Revit.UI.Selection import *\r\n\r\nclr.AddReference(\"RevitNodes\")\r\nimport Revit\r\n\r\nclr.ImportExtensions(Revit.Elements)\r\nclr.ImportExtensions(Revit.GeometryConversion)\r\n\r\nclr.AddReference(\"RevitServices\")\r\nimport RevitServices\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\nview = doc.ActiveView\r\nuidoc = DocumentManager.Instance.CurrentUIApplication.ActiveUIDocument\r\nuiapp = DocumentManager.Instance.CurrentUIApplication\r\napp = uiapp.Application\r\n\r\ndef select_folder():\r\n    folder_dialog = FolderBrowserDialog()\r\n    folder_dialog.Description = \"Select Folder\"\r\n    \r\n    # Hiển thị hộp thoại và kiểm tra nếu người dùng chọn OK\r\n    if folder_dialog.ShowDialog() == DialogResult.OK:\r\n        return folder_dialog.SelectedPath\r\n    else:\r\n        return None\r\n\r\n# Gọi hàm để chọn thư mục\r\nif not IN[0]:\r\n\tselected_folder = select_folder()\r\nelse:\r\n\tTaskDialog.Show(\"Error\",\"There is no any CAV or VAV\")\r\n\r\n\t# Trả kết quả về Dynamo\r\n\tOUT = selected_folder if selected_folder else \"No Folder\"\r\n",
      "Engine": "IronPython2",
      "EngineName": "IronPython2",
      "VariableInputPorts": true,
      "Id": "4db57a471c0740658e338b7d177512d8",
