    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "# Load the Python Standard and DesignScript Libraries\r\nimport sys\r\nimport clr\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import *\r\nclr.AddReference('RevitNodes')\r\nclr.AddReference('RevitServices')\r\nclr.AddReference('RevitAPI')\r\nclr.AddReference('RevitAPIUI')\r\n\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom Autodesk.Revit.DB import *\r\n\r\n# Get the current Revit document\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n# The inputs to this node will be stored as a list in the IN variables.\r\nelements = UnwrapElement(IN[0])  # Unwrap Revit elements\r\nparameterName = IN[1]            # Input parameter name\r\noutputResults = []\r\n\r\n# Ensure \"elements\" is iterable\r\nif not isinstance(elements, list):\r\n    elements = [elements]\r\n\r\n# Loop through each element and get the family type\r\nfor element in elements:\r\n    # Check if the element is a FamilyInstance\r\n    if isinstance(element, FamilyInstance):\r\n        familyType = element.Symbol\r\n        if familyType:\r\n            param = familyType.LookupParameter(parameterName)\r\n            if param and param.HasValue:\r\n                outputResults.append(param.AsString())\r\n            else:\r\n                outputResults.append(None)\r\n        else:\r\n            outputResults.append(None)\r\n    else:\r\n        outputResults.append(\"Not a FamilyInstance\")\r\n\r\n# Assign your output to the OUT variable\r\nOUT = outputResults\r\n",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
      "Id": "ed652c68f0f54852b65f0e28f28f78ab",
      "Inputs": [
        {
          "Id": "bd2b7764f2ca46f583a2747ce3210b6a",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "35220e86f30741709a58f93076f7bdbe",
          "Name": "IN[1]",
          "Description": "Input #1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
