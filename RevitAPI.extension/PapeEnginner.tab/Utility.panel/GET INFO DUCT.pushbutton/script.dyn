    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "# Input: List cấp 3 từ Dynamo\r\ninputList = IN[0]\r\n\r\n# Kết quả đầu ra\r\nresultA0 = []\r\nresultA1 = []\r\n\r\n# Xử lý từng phần tử trong list cấp 3\r\nfor subList in inputList:\r\n    if isinstance(subList, list):  # Kiểm tra nếu là list cấp 2\r\n        resultA0.append(subList[0] if len(subList) > 0 else None)  # Lấy a[0]\r\n        resultA1.append(subList[1] if len(subList) > 1 else None)  # Lấy a[1]\r\n    else:\r\n        resultA0.append(None)\r\n        resultA1.append(None)\r\n\r\n# Kết quả đầu ra: a[0] và a[1]\r\nOUT = resultA0, resultA1\r\n",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
      "Id": "87a2bf4eeda5470c81d745b1e7464c89",
      "Inputs": [
        {
          "Id": "92c3a10981384fcbbc4650ff43ed4d86",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "05bf87f84e6d47b6b3fd0ae245e401b9",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "# Input: List cấp 3 từ Dynamo\r\ninputList = IN[0]\r\n\r\n# Kết quả đầu ra\r\nresultA0 = []\r\nresultA1 = []\r\n\r\n# Xử lý từng phần tử trong list cấp 3\r\nfor subList in inputList:\r\n    if isinstance(subList, list):  # Kiểm tra nếu là list cấp 2\r\n        resultA0.append(subList[0] if len(subList) > 0 else None)  # Lấy a[0]\r\n        resultA1.append(subList[1] if len(subList) > 1 else None)  # Lấy a[1]\r\n    else:\r\n        resultA0.append(None)\r\n        resultA1.append(None)\r\n\r\n# Kết quả đầu ra: a[0] và a[1]\r\nOUT = resultA0, resultA1\r\n",
      "Engine": "CPython3",
