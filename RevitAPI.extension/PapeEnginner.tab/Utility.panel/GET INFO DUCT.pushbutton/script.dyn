    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "import os\r\nimport sys\r\nimport clr\r\nimport System\r\nimport math\r\nfrom System.Collections.Generic import *\r\n\r\nclr.AddReference(\"ProtoGeometry\")\r\nfrom Autodesk.DesignScript.Geometry import *\r\n\r\nclr.AddReference('RevitAPI')\r\nimport Autodesk\r\nfrom Autodesk.Revit.DB import *\r\n\r\nclr.AddReference('RevitAPIUI')\r\nfrom Autodesk.Revit.UI import *\r\nfrom Autodesk.Revit.UI.Selection import *\r\n\r\nclr.AddReference(\"RevitNodes\")\r\nimport Revit\r\n\r\nclr.ImportExtensions(Revit.Elements)\r\nclr.ImportExtensions(Revit.GeometryConversion)\r\n\r\nclr.AddReference(\"RevitServices\")\r\nimport RevitServices\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\nview = doc.ActiveView\r\nuidoc = DocumentManager.Instance.CurrentUIApplication.ActiveUIDocument\r\nuiapp = DocumentManager.Instance.CurrentUIApplication\r\napp = uiapp.Application\r\n\r\n\"\"\"-------------Preparing input from dynamo to revit----------------\"\"\"\r\nelement = IN[0]\r\n\r\n\"\"\"--------------------------Functions--------------------------\"\"\"\r\nclass SelectionFilter(ISelectionFilter):\r\n    def __init__(self, category):\r\n        self.category = category\r\n\r\n    def AllowElement(self, element):\r\n        if element.Category and element.Category.Name == self.category:\r\n            return True\r\n        return False\r\n\r\n    def AllowReference(self, reference, position):\r\n        return False\r\n\r\ndef CollectDuctAuto():\r\n    \"\"\"Automatically collect all duct accessories in the active view.\"\"\"\r\n    ductsEles = (\r\n        FilteredElementCollector(doc, view.Id)\r\n        .OfCategory(BuiltInCategory.OST_DuctAccessory)\r\n        .WhereElementIsNotElementType()\r\n        .ToElements()\r\n    )\r\n    return ductsEles\r\n\r\n\r\ndef CollectDuctManual():\r\n    \"\"\"Manually select duct accessories using Revit UI.\"\"\"\r\n    collectorDucts = uidoc.Selection.PickObjects(\r\n        ObjectType.Element, SelectionFilter(\"Duct Accessories\"), \"Select Duct Accessories\"\r\n    )\r\n    ductsEles = [doc.GetElement(s.ElementId) for s in collectorDucts]\r\n    return ductsEles\r\n\r\n\r\n\"\"\"--------------------------Main Code--------------------------\"\"\"\r\nif element:\r\n    result = CollectDuctAuto()\r\nelse:\r\n    result = CollectDuctManual()\r\n\r\n# Assign output to Dynamo\r\nOUT = result\r\n",
      "Engine": "IronPython2",
      "EngineName": "IronPython2",
      "VariableInputPorts": true,
      "Id": "f5335cf183be44688f48868dfa7a9e06",
      "Inputs": [
        {
          "Id": "cb5ce9e57d2d4ebbae85736b6158964f",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "0af5ad8fa7534c5198c0bc0895241757",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
