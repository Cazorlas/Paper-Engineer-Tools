    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "# Load the Python Standard and DesignScript Libraries\r\nimport clr\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import *\r\n\r\n# Nhận input từ Dynamo\r\nbooleanInput = IN[0]  # Danh sách Boolean (True/False)\r\nlistCheck = IN[1]  # Danh sách các số\r\n\r\n# Kiểm tra nếu listCheck là một danh sách, nếu không, đưa nó về dạng danh sách\r\nlistCheck = listCheck if isinstance(listCheck, list) else [listCheck]\r\nbooleanInput = booleanInput if isinstance(booleanInput, list) else [booleanInput]\r\n\r\n# Đảm bảo hai danh sách có cùng độ dài\r\nmin_length = min(len(booleanInput), len(listCheck))\r\nbooleanInput = booleanInput[:min_length]\r\nlistCheck = listCheck[:min_length]\r\n\r\n# Danh sách kết quả\r\nresult = []\r\n\r\n# Xử lý dữ liệu\r\nfor i in range(min_length):\r\n    if booleanInput[i]:  # Nếu là True\r\n        result.append(-abs(listCheck[i]))  # Trả về số dương\r\n    else:  # Nếu là False\r\n        result.append(abs(listCheck[i]))  # Trả về số âm\r\n\r\n# Gán kết quả vào OUT\r\nOUT = result\r\n",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
      "Id": "986dc4fa03b8465ab36bc031d4927360",
      "Inputs": [
        {
          "Id": "ea9f9ec74c1f4dbea370738c45cb2e15",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "99e10421a4474d87af863755e3e07900",
          "Name": "IN[1]",
          "Description": "Input #1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "e748d777acbe441fb8712bc90ed0effd",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
