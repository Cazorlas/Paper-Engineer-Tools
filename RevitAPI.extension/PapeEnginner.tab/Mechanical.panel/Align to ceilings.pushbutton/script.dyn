    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "import clr\nclr.AddReference('ProtoGeometry')\nfrom Autodesk.DesignScript.Geometry import *\n#The inputs to this node will be stored as a list in the IN variables.\nxv = IN[0]\nyv = IN[1]\na = []\nb = []\nbool = []\n\nfor i,j in zip(xv,yv):\n\ttry:\n\t\tif i==False and j==False:\n\t\t\ta.append(i)\n\t\t\tb.append(j)\n\t\t\tbool.append(True)\t\n\t\telse:\n\t\t\tbool.append(False)\n\texcept:\n\t\tprint(\"error\")\n#Assign your output to the OUT variable.\nOUT = bool",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
      "Id": "b82bdfd2c27d41a892517c8ca78e9338",
      "Inputs": [
        {
          "Id": "0f3cb11a6bfc40e2b605ca0fb4ff6394",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "bd51fa3b43f84650b5108420868a8212",
          "Name": "IN[1]",
          "Description": "Input #1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "0d33b875f1e84a4cbd921426f4514e12",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
